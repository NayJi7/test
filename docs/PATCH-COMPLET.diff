-# execute as script code the moment this line runs.
-$InputPathRaw = @'
-INPUT_PATH
-'@
-[System.IO.File]::WriteAllText((Join-Path $PWD 'graphify-out\.graphify_root'), (Resolve-Path $InputPathRaw.Trim()).Path, $Utf8NoBom)
