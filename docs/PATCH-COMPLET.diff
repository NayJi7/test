-    parenthesis (``foo()`` -> ``foo``, ``Cls.method(x)`` -> ``Cls``/``method``)."""
-    if not label:
-        return []
-    base = label.split("(", 1)[0]
-    return [t for t in _LABEL_IDENT_RE.findall(base) if len(t) >= 3]
