+def _forbidden_hits(paths) -> list[str]:
+    hits = []
+    for path in paths:
+        text = Path(path).read_text(encoding="utf-8", errors="replace")
+        hits += [f"{path}: {needle}" for needle in FORBIDDEN_IN_SKILLS if needle in text]
+    return hits
