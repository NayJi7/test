-        "--json", _PR_JSON_FIELDS,
-    ]
-    if repo:
-        args += ["--repo", repo]
-
-    raw = _gh(*args)
-    if raw is None:
-        raise RuntimeError("gh CLI not found or not authenticated. Run: gh auth login")
-
-    return [_parse_pr_dict(item, resolved_base) for item in raw]
